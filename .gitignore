# ===== Python 环境与缓存 =====
.venv/
__pycache__/
*.py[cod]

# ===== IDE / 工具工作目录 =====
.idea/
.workbuddy/

# ===== 模型权重（大文件不入库；本地文件保留，不会被删除）=====
*.pt

# ===== 诊断 / 运行临时产物 =====
cam_test/
*.log
video_feed_sample.bin
benchmark_results.csv
_front_check.js
# 精度评估时为对齐类别下标而生成的临时数据集（图像拷贝 + 重写标注 + 绝对路径 yaml）
.eval_cache/

# ===== 滚动录制段与用户画的区域（运行时产物，不入库）=====
recordings/
zones.json

# ===== 可从 Roboflow 重下载的中间导出（不入库；datasets/ 黄金集入库）=====
person-50/
vehicle-50/
*.yolov8.zip

# 注：dataset/ 与 datasets/（黄金数据集与 data.yaml）需要入库，不忽略
# 注：eval_reports/（评估报告专用文件夹：evaluation_report.csv 汇总台账 + runs/ 每次 mAP 独立快照）需要入库
